# Supabase (required)
# Project URL must match the "ref" in your API keys (check JWT payload or dashboard URL).
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key (sb_publishable_...) or legacy anon JWT
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Secret key (sb_secret_...) or legacy service_role JWT — server-only, never commit
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=location-photos

# Upstash Redis (rate limiting). Optional for local dev; if unset, an
# in-memory limiter is used.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Scoring (tunable without redeploy)
SCORE_FULL_M=25
SCORE_ZERO_M=500
SCORE_MAX=5000
GAME_ROUNDS=5

# Map default
CAMPUS_CENTER_LAT=35.3074
CAMPUS_CENTER_LNG=-80.7350

# Seed script (only used by scripts/seed.ts)
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=Passw0rd!
